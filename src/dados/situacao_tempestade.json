  "base_conhecimento": [
    {
      "id": "KB-001",
      "titulo": "Limites de vento para navegação",
      "tags": [
        "vento",
        "limites",
        "seguranca"
      ],
      "texto": "Na simulação, ventos sustentados acima de 25 nós são considerados fora da navegação normal. Entre 25 e 33 nós recomenda-se reduzir a velocidade e reavaliar a rota. Acima de 34 nós (vendaval) a prioridade é evitar a área do sistema."
    },
    {
      "id": "KB-002",
      "titulo": "Velocidade em mar agitado",
      "tags": [
        "velocidade",
        "ondas",
        "tempestade"
      ],
      "texto": "Com ondas acima de 3 metros, a velocidade deve ser reduzida para diminuir o balanço, o slamming e o risco de dano à carga. Os limites numéricos de velocidade em tempestade estão em KB-009. Acima de 5 metros, a embarcação deve buscar abrigo ou alterar o rumo para diminuir a exposição às ondas."
    },
    {
      "id": "KB-003",
      "titulo": "Rota direta versus rota protegida",
      "tags": [
        "rota",
        "tempestade",
        "decisao"
      ],
      "texto": "A rota direta é cerca de 15 por cento mais curta, mas atravessa mar aberto e fica mais exposta a tempestades. A rota protegida segue perto da costa, aumenta a distância em torno de 15 por cento e reduz a altura das ondas. Em alerta de tempestade, a rota protegida tende a ser a escolha mais segura."
    },
    {
      "id": "KB-004",
      "titulo": "Marés e folga sob a quilha",
      "tags": [
        "mare",
        "calado",
        "porto"
      ],
      "texto": "A folga sob a quilha é a diferença entre a profundidade disponível e o calado do navio. A maré alta aumenta a profundidade e permite entrar com mais calado. Na simulação, a folga mínima aceitável é de 1,0 metro."
    },
    {
      "id": "KB-005",
      "titulo": "Janela de maré para entrada em porto",
      "tags": [
        "mare",
        "porto",
        "planejamento"
      ],
      "texto": "Navios com calado próximo ao limite do porto devem chegar na janela de maré alta, de preferência na preamar ou na primeira hora após ela. Chegar na baixa-mar pode exigir espera em fundeadouro. O horário de chegada deve ser ajustado reduzindo ou aumentando a velocidade ao longo da viagem."
    },
    {
      "id": "KB-006",
      "titulo": "Como ler a tábua de marés",
      "tags": [
        "mare",
        "tabela"
      ],
      "texto": "A tábua lista os eventos do dia em ordem: preamar (maré alta) e baixa-mar (maré baixa), cada um com hora e altura em metros. Em geral ocorrem dois pares por dia e os horários avançam cerca de 50 minutos a cada dia. A amplitude é a diferença entre alta e baixa consecutivas."
    },
    {
      "id": "KB-007",
      "titulo": "Procedimento geral em tempestade",
      "tags": [
        "tempestade",
        "procedimento",
        "seguranca"
      ],
      "texto": "Ao receber aviso de tempestade: confirmar a previsão da zona, reduzir a velocidade respeitando o limite da rota (KB-009), avaliar a troca para a rota protegida, garantir a amarração da carga e registrar toda decisão. Alterações de velocidade devem ser validadas antes de serem aplicadas ao navio."
    },
    {
      "id": "KB-008",
      "titulo": "Visibilidade reduzida",
      "tags": [
        "visibilidade",
        "velocidade",
        "seguranca"
      ],
      "texto": "Com visibilidade abaixo de 3 milhas náuticas, a velocidade deve ser compatível com a distância de parada do navio. Na simulação, recomenda-se não manter velocidade plena abaixo desse valor e reforçar a vigilância."
    },
    {
      "id": "KB-009",
      "titulo": "Limites de velocidade em tempestade",
      "tags": [
        "velocidade",
        "tempestade",
        "limites",
        "rota",
        "no_action"
      ],
      "texto": "Em tempestade, o limite máximo de velocidade depende da rota: na rota direta, 12 nós; na rota protegida, 15 nós. Um navio que não está em tempestade não precisa alterar a velocidade (ação NO_ACTION). Em qualquer caso, a velocidade proposta deve ficar entre 0 e 18 nós, em passos de 0,5 nó."
    },
    {
      "id": "KB-010",
      "titulo": "Redução de velocidade em tempestade: procedimento",
      "tags": [
        "procedimento",
        "velocidade",
        "tempestade",
        "revisao"
      ],
      "texto": "Na primeira proposta para um navio em tempestade, reduzir a velocidade em 1 nó em relação à velocidade atual. Se o revisor rejeitar a proposta por violar o limite da rota, a nova proposta deve ficar no limite aplicável ou abaixo dele, conforme o feedback recebido."
    }
  ]
}